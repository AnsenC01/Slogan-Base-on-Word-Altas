/* 悬浮胶囊 tabBar：白色药丸 + 柔和双层阴影，浮在页面内容之上 */
.tabbar-float {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 36rpx;
  z-index: 999;
  display: flex;
  align-items: stretch;
  box-sizing: border-box;
  background: #ffffff;
  border: 1rpx solid rgba(231, 221, 205, 0.8);
  border-radius: 999rpx;
  padding: 18rpx 10rpx 20rpx;
  box-shadow: 0 20rpx 50rpx rgba(23, 40, 59, 0.16), 0 6rpx 16rpx rgba(23, 40, 59, 0.08);
}
.tab-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.tab-icon {
  width: 44rpx;
  height: 44rpx;
}
.tab-label {
  font-size: 20rpx;
  line-height: 1.2;
  color: #7a7168;
}
.tab-item.is-on .tab-label {
  color: #17283b;
  font-weight: 600;
}
