.quiz-option {
  width: 100%;
  background: #fffcf6;
  border: 1rpx solid #ded1bd;
  border-radius: 16rpx;
  padding: 26rpx 24rpx;
  font-size: 30rpx;
  text-align: left;
  color: #17283b;
  line-height: 1.3;
  margin: 0;
}

.quiz-option::after {
  border: none;
}

.quiz-option.selected {
  border-color: #17283b;
  background: #eef0f2;
}

.quiz-option.correct {
  border-color: #2f6b4f;
  background: #e4f0e8;
  color: #24523c;
}

.quiz-option.wrong {
  border-color: #ad5038;
  background: #f7e6df;
  color: #8a3c28;
}

.quiz-option[disabled] {
  opacity: 0.9;
}

.option-label {
  font-size: 30rpx;
}
