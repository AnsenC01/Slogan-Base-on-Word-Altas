.wp-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  background: rgba(23, 40, 59, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.wp-card {
  width: 100%;
  max-width: 640rpx;
  background: #fffcf6;
  border: 1rpx solid #e7ddcd;
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
  color: #17283b;
}

.wp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.wp-title {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  min-width: 0;
}

.wp-word {
  font-size: 46rpx;
  font-weight: 600;
  overflow-wrap: break-word;
}

.wp-star {
  font-size: 38rpx;
  line-height: 1;
  color: #c9c2b7;
}

.wp-star.is-on {
  color: #f2b134;
}

.wp-detail-btn {
  flex: none;
  font-size: 24rpx;
  color: #6f665c;
  border: 1rpx solid #cbbca6;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.wp-detail-btn.is-on {
  background: #efe5d5;
}

.wp-from {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8d8377;
}

.wp-phonetics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 32rpx;
  margin-top: 20rpx;
}

.wp-ph {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.wp-play {
  font-size: 22rpx;
  color: #2f8f6b;
}

.wp-ph-label {
  font-size: 22rpx;
  color: #8d8377;
}

.wp-ipa {
  font-size: 26rpx;
  color: #4c463f;
}

.wp-meaning {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 12rpx;
}

.wp-pos {
  font-size: 22rpx;
  color: #6f665c;
  background: #efe5d5;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.wp-zh {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  line-height: 1.6;
  overflow-wrap: break-word;
}

.wp-expanded {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e7ddcd;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wp-sense {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 10rpx;
}

.wp-sense-pos {
  font-size: 22rpx;
  color: #6f665c;
}

.wp-sense-zh {
  font-size: 28rpx;
}

.wp-sense-en {
  flex: 1 0 100%;
  font-size: 24rpx;
  color: #6f665c;
  line-height: 1.5;
}

.wp-example {
  padding: 16rpx;
  background: #f4ece0;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.wp-example-en {
  font-size: 26rpx;
  line-height: 1.6;
  overflow-wrap: break-word;
}

.wp-example-cn {
  font-size: 24rpx;
  color: #7a7168;
}

.wp-add {
  margin-top: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #2f8f6b;
  color: #fff;
  font-size: 28rpx;
}

.wp-add.is-on {
  background: #efe5d5;
  color: #4c463f;
}
