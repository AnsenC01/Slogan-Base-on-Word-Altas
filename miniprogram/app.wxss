page {
  background: #f7f2e9;
  color: #17283b;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
  /* 禁止真机横向滑动 */
  overflow-x: hidden;
  max-width: 100%;
}

.page {
  padding: 40rpx 32rpx 64rpx;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}
.page-head {
  margin-bottom: 32rpx;
}
.eyebrow {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #ad5038;
}
.display {
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  margin: 12rpx 0 8rpx;
}
.lede {
  font-size: 26rpx;
  color: #6f665c;
}

.panel {
  background: #fffcf6;
  border: 1rpx solid #e7ddcd;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 40, 59, 0.05);
}

.btn-primary {
  background: #17283b;
  color: #fdf9f1;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  text-align: center;
  border: none;
}
.btn-primary::after {
  border: none;
}
.btn-ghost {
  background: transparent;
  color: #17283b;
  border: 1rpx solid #cbbca6;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 22rpx 0;
  text-align: center;
}
.btn-ghost::after {
  border: none;
}
.btn-primary[disabled],
.btn-ghost[disabled] {
  opacity: 0.45;
}

.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #efe5d5;
  color: #6f665c;
  font-size: 22rpx;
  margin-right: 12rpx;
}
.tag.is-on {
  background: #17283b;
  color: #fdf9f1;
}

.empty {
  text-align: center;
  color: #8d8377;
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* 英音/美音/例句共用的大腰形背景：三个小按钮作为等分分段放在其中 */
.audio-group {
  display: flex;
  align-items: stretch;
  height: 84rpx;
  margin-top: 24rpx;
  background: #f4ece0;
  border: 1rpx solid #ded1bd;
  border-radius: 999rpx;
  overflow: hidden;
  box-sizing: border-box;
}
.audio-divider {
  flex: none;
  width: 1rpx;
  align-self: stretch;
  margin: 16rpx 0;
  background: #d8c9b3;
}

/* 学习/复习页词卡左右隐形点击热区：只接收点击，不显示任何视觉元素。
   纵向自插画下沿（card-wrap 内边距 28rpx + 插画 440rpx）到卡片底部；
   横向向外扩 32rpx 覆盖页面侧边，宽度约屏宽 16%，中间大片区域仍留给词条内容。 */
.tap-zone {
  position: absolute;
  top: 468rpx;
  bottom: 0;
  width: 120rpx;
  z-index: 2;
  background: transparent;
  border: none;
}
.tap-zone-left {
  left: -32rpx;
}
.tap-zone-right {
  right: -32rpx;
}

/* 首次使用引导层（一次性）：只保留左右两个透明虚线框，框内只有提示词。
   位置与隐形热区完全重合；关闭后整层移除，热区本体恢复不可见 */
.tap-guide {
  position: absolute;
  top: 0;
  right: -32rpx;
  bottom: 0;
  left: -32rpx;
  z-index: 3;
  background: transparent;
  box-sizing: border-box;
}
.tap-guide-side {
  position: absolute;
  top: 468rpx;
  bottom: 0;
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-sizing: border-box;
  /* 内部透明：不铺任何底色，只用四边虚线描出圆角框 */
  background: transparent;
  border: 2rpx dashed;
  border-radius: 24rpx;
}
.tap-guide-left {
  left: 0;
  border-color: rgba(173, 80, 56, 0.75);
}
.tap-guide-right {
  right: 0;
  border-color: rgba(23, 40, 59, 0.7);
}
.tap-guide-word {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.25;
  color: #17283b;
}
.tap-guide-left .tap-guide-word {
  color: #ad5038;
}

/* ===== 生词本模块通用样式：沿用暖米背景，主操作用参考图的绿色 ===== */
.wb-primary {
  background: #2f8f6b;
  color: #fffdf9;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 22rpx 0;
  text-align: center;
  border: none;
}
.wb-primary::after {
  border: none;
}
.wb-outline {
  background: #fffdf9;
  color: #2f8f6b;
  border: 1rpx solid #2f8f6b;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 22rpx 0;
  text-align: center;
}
.wb-outline::after {
  border: none;
}
.wb-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 0 16rpx;
}
.wb-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #17283b;
}
.wb-section-note {
  font-size: 22rpx;
  color: #8d8377;
}

/* 弹层 */
.wb-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(23, 40, 59, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
}
.wb-dialog {
  width: 620rpx;
  max-height: 78vh;
  overflow-y: auto;
  box-sizing: border-box;
  background: #fffcf6;
  border-radius: 24rpx;
  padding: 36rpx;
}
.wb-dialog-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #17283b;
  margin-bottom: 24rpx;
}
.wb-input {
  /* 小程序 input 默认内容高度较小，只靠 padding 会裁切文字；显式高度 + 行高保证完整显示 */
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  box-sizing: border-box;
  background: #fffdf9;
  border: 1rpx solid #ded1bd;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #17283b;
}
.wb-dialog-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.wb-dialog-actions > button {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  padding: 20rpx 0;
}
.wb-option-list {
  display: flex;
  flex-direction: column;
  max-height: 420rpx;
  overflow-y: auto;
}
.wb-option {
  padding: 20rpx 12rpx;
  font-size: 27rpx;
  color: #17283b;
  border-bottom: 1rpx solid #eee4d5;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.wb-option.is-on {
  color: #2f8f6b;
  font-weight: 600;
}
.wb-option-sub {
  font-size: 22rpx;
  color: #8d8377;
  margin-left: 12rpx;
}
/* 词库列表 / 词条详情的收藏五角星：空心灰＝未加入，实心黄＝已加入默认生词本 */
.star {
  font-size: 44rpx;
  line-height: 1;
  color: #c9c2b7;
  flex: none;
}

.star.is-on {
  color: #f2b134;
}

.wb-set-default {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #2f8f6b;
  text-align: center;
  border: 1rpx solid #2f8f6b;
  border-radius: 999rpx;
  padding: 16rpx 0;
}

.wb-danger {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #ad5038;
  text-align: center;
}

/* 右上角气泡菜单 */
.wb-menu-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 18;
  background: transparent;
}
.wb-menu {
  position: fixed;
  top: 16rpx;
  right: 24rpx;
  width: 380rpx;
  z-index: 19;
  box-sizing: border-box;
  background: #fffdf9;
  border: 1rpx solid #e7ddcd;
  border-radius: 20rpx;
  padding: 12rpx 0;
  box-shadow: 0 12rpx 32rpx rgba(23, 40, 59, 0.18);
}
.wb-menu-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 28rpx;
  font-size: 26rpx;
  color: #17283b;
}
.wb-menu-sep {
  height: 1rpx;
  background: #eee4d5;
  margin: 8rpx 24rpx;
}
.wb-radio-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 2rpx solid #cbbca6;
  box-sizing: border-box;
  flex: none;
}
.wb-menu-item.is-on .wb-radio-dot {
  border: 8rpx solid #2f8f6b;
}
.wb-menu-item.is-on {
  color: #2f8f6b;
}

/* 词条行右侧发音喇叭（纯 CSS 绘制，避免图片资源） */
.wb-speaker {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  flex: none;
}
.wb-speaker .sp-box {
  position: absolute;
  left: 2rpx;
  top: 16rpx;
  width: 10rpx;
  height: 12rpx;
  background: #2f8f6b;
}
.wb-speaker .sp-cone {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  width: 0;
  height: 0;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-left: 14rpx solid #2f8f6b;
}
.wb-speaker .sp-wave {
  position: absolute;
  left: 25rpx;
  top: 12rpx;
  width: 10rpx;
  height: 20rpx;
  border-right: 3rpx solid #2f8f6b;
  border-radius: 0 60% 60% 0;
}
.wb-speaker .sp-wave2 {
  position: absolute;
  left: 28rpx;
  top: 6rpx;
  width: 14rpx;
  height: 32rpx;
  border-right: 3rpx solid #2f8f6b;
  border-radius: 0 60% 60% 0;
  opacity: 0.65;
}
.wb-speaker.is-playing {
  transform: scale(1.12);
}

/* 词表页底部浮动工具条：白色药丸浮层，强化悬浮感（参考悬浮胶囊菜单） */
.wb-float-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 36rpx;
  z-index: 12;
  display: flex;
  align-items: stretch;
  gap: 4rpx;
  box-sizing: border-box;
  background: #fffdf9;
  border: 1rpx solid rgba(231, 221, 205, 0.75);
  border-radius: 999rpx;
  padding: 22rpx 20rpx;
  box-shadow: 0 20rpx 50rpx rgba(23, 40, 59, 0.16), 0 6rpx 16rpx rgba(23, 40, 59, 0.08);
}
.wb-float-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #17283b;
  line-height: 1.25;
}
.wb-float-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  border: 2rpx solid #2f8f6b;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #2f8f6b;
  background: rgba(47, 143, 107, 0.06);
}
