/* 为悬浮自定义 tabBar 留出底部空间，避免遮挡页面末尾内容 */
.page { padding-bottom: 180rpx; }

/* 项目全局 .page-head 内的 text 为行内元素，会挤成一行；本页单独块级化，保持首屏可读 */
.wordbook .page-head .eyebrow,
.wordbook .page-head .display,
.wordbook .page-head .lede {
  display: block;
}

.book-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 左滑删除：删除按钮固定在卡片右侧，卡片左移后露出 */
.book-swipe {
  position: relative;
}
.book-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 160rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ad5038;
  color: #fffdf9;
  font-size: 28rpx;
  border-radius: 0 24rpx 24rpx 0;
}

.book-card {
  position: relative;
  z-index: 1;
  transition: transform 0.22s ease;
  background: #fffcf6;
  border: 1rpx solid #e7ddcd;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 40, 59, 0.05);
}

.book-top {
  display: flex;
  gap: 24rpx;
}

.book-cover {
  width: 112rpx;
  height: 148rpx;
  flex: none;
  position: relative;
  overflow: hidden;
  border-radius: 12rpx;
  box-sizing: border-box;
  padding: 14rpx 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: linear-gradient(150deg, #f7b27a, #e9704a);
  color: #fffdf9;
}

.book-cover::after {
  content: '';
  position: absolute;
  right: -46rpx;
  bottom: -46rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
}

.cover-title {
  position: relative;
  z-index: 1;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.3;
  overflow-wrap: break-word;
}

.cover-sub {
  position: relative;
  z-index: 1;
  font-size: 14rpx;
  letter-spacing: 1rpx;
  opacity: 0.85;
}

.book-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 8rpx;
}

.book-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.book-name {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: #17283b;
  overflow-wrap: break-word;
}

.default-badge {
  flex: none;
  font-size: 20rpx;
  color: #2f8f6b;
  background: #e6f4ed;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}

.edit-btn {
  flex: none;
  font-size: 22rpx;
  color: #8d8377;
  border: 1rpx solid #ded1bd;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}

.book-sub,
.book-tip {
  font-size: 24rpx;
  color: #6f665c;
}

.book-tip {
  font-size: 22rpx;
  color: #a89e91;
}

.book-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.book-btn {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  padding: 20rpx 0;
}

.create-btn {
  width: 100%;
  box-sizing: border-box;
  background: #efe9df;
  border-radius: 20rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #17283b;
}
