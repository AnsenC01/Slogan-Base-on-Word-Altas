.review-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.counter {
  font-size: 24rpx;
  color: #8d8377;
}

.bar {
  height: 8rpx;
  border-radius: 999rpx;
  background: #efe5d5;
  overflow: hidden;
  margin: 16rpx 0 28rpx;
}

.bar-fill {
  height: 100%;
  background: #ad5038;
}

.card-wrap {
  /* 作为左右隐形点击热区的定位参照 */
  position: relative;
  background: #fffcf6;
  border: 1rpx solid #e7ddcd;
  border-radius: 24rpx;
  padding: 28rpx;
}

/* 三音频按钮组样式统一在 app.wxss 的 .audio-group */

.reveal-area,
.rate-area {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hint {
  font-size: 24rpx;
  color: #8d8377;
  text-align: center;
}

.quick-row {
  display: flex;
  gap: 16rpx;
}

.quick-btn {
  flex: 1;
  background: #efe5d5;
  color: #17283b;
  border-radius: 16rpx;
  border: none;
  padding: 22rpx 0;
  font-size: 28rpx;
}

.quick-btn::after {
  border: none;
}

.quick-btn.is-known {
  background: #17283b;
  color: #fdf9f1;
}

.rate-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.rate-btn {
  background: #efe5d5;
  color: #17283b;
  border-radius: 16rpx;
  border: none;
  padding: 22rpx 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.rate-btn::after {
  border: none;
}

.rate-btn.again {
  background: #ad5038;
  color: #fdf9f1;
}

.rate-btn.good {
  background: #17283b;
  color: #fdf9f1;
}

.rate-label {
  font-size: 28rpx;
}

.rate-sub {
  font-size: 20rpx;
  opacity: 0.72;
}

.result {
  padding-top: 120rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
