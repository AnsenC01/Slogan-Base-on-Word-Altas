<view class="page wordbook-list" wx:if="{{!notFound}}">
  <view class="wb-head">
    <view class="wb-tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="wb-tab {{activeTab === item.key ? 'is-on' : ''}}"
        data-key="{{item.key}}"
        bindtap="switchTab"
      >{{item.label}}</view>
    </view>
    <text class="wb-more" catchtap="toggleMenu">···</text>
  </view>

  <view class="wb-summary">
    <text class="wb-count">{{bookName}} · {{count}} 词</text>
    <view class="wb-filter" bindtap="openCefr">{{selectedCefr === 'ALL' ? '全部' : selectedCefr}} ▼</view>
  </view>

  <view class="wb-chips">
    <view class="review-chip {{reviewOnly ? 'is-on' : ''}}" bindtap="toggleReviewOnly">复习词 {{reviewCount}}</view>
    <text wx:if="{{removeMode}}" class="remove-tip">点右侧「移除」移出本子</text>
  </view>

  <view class="wb-list">
    <view class="wb-row" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleReveal">
      <view class="wb-row-main">
        <view class="wb-word-line">
          <block wx:if="{{maskMode !== 'word' || revealed[item.id]}}">
            <text class="wb-word">{{item.word}}</text>
            <text wx:if="{{item.pos}}" class="wb-pos">{{item.pos}}</text>
          </block>
          <view wx:else class="mask-bar mask-word"></view>
          <text class="wb-phonetic">{{item.phoneticUK}}</text>
        </view>
        <block wx:if="{{maskMode !== 'meaning' || revealed[item.id]}}">
          <text class="wb-meaning">{{item.meaningCN}}</text>
        </block>
        <view wx:else class="mask-bar mask-meaning"></view>
        <text wx:if="{{item.isReview}}" class="row-review-tag">复习词</text>
      </view>
      <view class="wb-row-side">
        <view
          class="wb-speaker {{audioStatus === 'playing' ? 'is-playing' : ''}}"
          data-uk="{{item.audioUK}}"
          data-us="{{item.audioUS}}"
          data-url="{{item.audioUrl}}"
          catchtap="playRowAudio"
        >
          <view class="sp-box"></view>
          <view class="sp-cone"></view>
          <view class="sp-wave"></view>
          <view class="sp-wave2"></view>
        </view>
        <text wx:if="{{removeMode}}" class="remove-btn" data-id="{{item.id}}" catchtap="removeOne">移除</text>
      </view>
    </view>
    <view wx:if="{{!rows.length}}" class="empty">该分类下没有词条</view>
  </view>
  <view class="list-tail">显示 {{listCount}} / {{count}} 词</view>
</view>

<view class="page" wx:if="{{notFound}}">
  <view class="empty">未找到该生词本</view>
  <button class="btn-ghost" bindtap="back">返回</button>
</view>

<view wx:if="{{!notFound}}" class="wb-float-bar">
  <view class="wb-float-item" bindtap="startStudy">
    <view class="wb-float-icon">学</view>
    <text>开始学习</text>
  </view>
  <view class="wb-float-item" bindtap="startRush">
    <view class="wb-float-icon">刷</view>
    <text>极速刷词</text>
  </view>
  <view class="wb-float-item" bindtap="exportList">
    <view class="wb-float-icon">导</view>
    <text>导出词表</text>
  </view>
</view>

<view wx:if="{{menuOpen}}" class="wb-menu-mask" bindtap="closeMenu"></view>
<view wx:if="{{menuOpen}}" class="wb-menu">
  <view class="wb-menu-item" bindtap="openGoal">设置任务量</view>
  <view class="wb-menu-item" bindtap="toggleRemoveMode">{{removeMode ? '退出移除' : '移除生词'}}</view>
  <view class="wb-menu-item" bindtap="openAdd">添加生词</view>
  <view class="wb-menu-item" bindtap="clearAll">一键清空</view>
  <view class="wb-menu-sep"></view>
  <view
    wx:for="{{maskOptions}}"
    wx:key="value"
    class="wb-menu-item {{maskMode === item.value ? 'is-on' : ''}}"
    data-value="{{item.value}}"
    bindtap="chooseMask"
  >
    <view class="wb-radio-dot"></view>
    <text>{{item.label}}</text>
  </view>
</view>

<view wx:if="{{dialog}}" class="wb-mask" bindtap="closeDialog">
  <view class="wb-dialog" catchtap="noop">
    <block wx:if="{{dialog === 'goal'}}">
      <text class="wb-dialog-title">设置任务量</text>
      <view class="wb-option-list">
        <view
          class="wb-option {{dailyGoal === item ? 'is-on' : ''}}"
          wx:for="{{goalOptions}}"
          wx:key="*this"
          data-value="{{item}}"
          bindtap="chooseGoal"
        >{{item}} 词 / 天</view>
      </view>
    </block>
    <block wx:elif="{{dialog === 'cefr'}}">
      <text class="wb-dialog-title">筛选等级</text>
      <view class="wb-option-list">
        <view
          class="wb-option {{selectedCefr === item ? 'is-on' : ''}}"
          wx:for="{{cefrLevels}}"
          wx:key="*this"
          data-value="{{item}}"
          bindtap="chooseCefr"
        >{{item === 'ALL' ? '全部' : item}}</view>
      </view>
    </block>
    <block wx:elif="{{dialog === 'add'}}">
      <text class="wb-dialog-title">添加生词</text>
      <input
        class="wb-input"
        value="{{searchKeyword}}"
        placeholder="搜索单词或中文释义"
        bindinput="onSearchInput"
      />
      <view class="wb-option-list">
        <view
          class="wb-option"
          wx:for="{{searchResults}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="addOne"
        >
          <text>{{item.word}}</text>
          <text class="wb-option-sub">{{item.meaningCN}}</text>
        </view>
        <text wx:if="{{searchKeyword && !searchResults.length}}" class="wb-empty">没有匹配的词条</text>
      </view>
    </block>
    <view class="wb-dialog-actions">
      <button class="btn-ghost" bindtap="closeDialog">关闭</button>
    </view>
  </view>
</view>
