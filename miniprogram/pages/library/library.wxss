/* 为悬浮自定义 tabBar 留出底部空间，避免遮挡页面末尾内容 */
.page { padding-bottom: 180rpx; }

.search-wrap {
  display: flex;
  align-items: center;
  background: #fffcf6;
  border: 1rpx solid #e7ddcd;
  border-radius: 999rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  padding: 14rpx 0;
  color: #17283b;
}

.search-clear {
  font-size: 24rpx;
  color: #ad5038;
  padding-left: 16rpx;
}

.filter-group {
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.filter-title {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #8d8377;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chips .tag {
  margin-right: 0;
  padding: 10rpx 20rpx;
}

.word-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.word-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fffcf6;
  border: 1rpx solid #e7ddcd;
  border-radius: 20rpx;
  padding: 20rpx;
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  background: #efe5d5;
  flex-shrink: 0;
}

.word-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.word-top {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.word-text {
  font-size: 34rpx;
  font-weight: 600;
}

.pos {
  font-size: 22rpx;
  color: #6f665c;
  background: #efe5d5;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  white-space: nowrap;
}

.phonetic {
  font-size: 22rpx;
  color: #8d8377;
}

.meaning {
  font-size: 24rpx;
  color: #6f665c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.word-tags {
  display: flex;
  gap: 10rpx;
}

.word-tags .tag {
  margin-right: 0;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
}

.item-side {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.status {
  font-size: 22rpx;
  flex-shrink: 0;
}

.status-unseen {
  color: #a89e91;
}

.status-new,
.status-learning {
  color: #ad5038;
}

.status-review,
.status-mastered {
  color: #2f6b4f;
}
